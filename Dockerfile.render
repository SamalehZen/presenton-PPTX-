FROM python:3.11-slim-bookworm AS builder

RUN apt-get update && apt-get install -y \
    curl \
    && curl -fsSL https://deb.nodesource.com/setup_20.x | bash - \
    && apt-get install -y nodejs \
    && rm -rf /var/lib/apt/lists/*

# Skip Puppeteer bundled Chromium download — we use the system one at runtime
ENV PUPPETEER_SKIP_DOWNLOAD=true

WORKDIR /app/servers/nextjs
COPY servers/nextjs/package.json servers/nextjs/package-lock.json ./
# Need ALL deps including devDeps (tailwindcss, typescript, esbuild) to build
RUN npm ci

COPY servers/nextjs/ ./
RUN npm run build && rm -rf .next-build/cache

# After build, prune devDependencies so only runtime deps carry to final image
RUN npm prune --omit=dev

# -----------------------------------------------------------
FROM python:3.11-slim-bookworm

RUN apt-get update && apt-get install -y --no-install-recommends \
    nginx \
    curl \
    libreoffice-writer \
    libreoffice-calc \
    libreoffice-impress \
    fontconfig \
    chromium \
    && curl -fsSL https://deb.nodesource.com/setup_20.x | bash - \
    && apt-get install -y --no-install-recommends nodejs \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

WORKDIR /app

ENV APP_DATA_DIRECTORY=/app_data
ENV TEMP_DIRECTORY=/tmp/presenton
ENV PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium
ENV NODE_ENV=production

# Python deps — docling replaced by python-docx (lightweight), nltk removed (unused)
RUN pip install --no-cache-dir \
    alembic aiohttp aiomysql aiosqlite asyncpg \
    fastapi[standard] pathvalidate pdfplumber \
    chromadb sqlmodel anthropic google-genai \
    openai fastmcp dirtyjson python-pptx \
    python-docx redis httpx

# Copy built Next.js app (with pruned node_modules — runtime deps only)
COPY --from=builder /app/servers/nextjs /app/servers/nextjs

COPY servers/fastapi/ ./servers/fastapi/
# Replace heavy docling service with lightweight version
COPY servers/fastapi/services/docling_service_lite.py ./servers/fastapi/services/docling_service.py

# Root package.json is required — start.js uses ESM imports and needs "type": "module"
COPY package.json start.js LICENSE NOTICE ./
COPY nginx.render.conf /etc/nginx/nginx.conf

EXPOSE 10000

CMD ["node", "/app/start.js"]
